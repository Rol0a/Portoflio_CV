# Database
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=changeme
POSTGRES_DB=portfolio
DATABASE_URL=postgresql+asyncpg://portfolio:changeme@postgres:5432/portfolio

# Admin (seeded later, M9)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Backend
SESSION_SECRET_KEY=changeme-random-64-char-string
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Peers allowed to set X-Forwarded-For — i.e. where the reverse proxy sits.
# Accepts comma-separated IPs and/or CIDR ranges.
#
# Dev (below): loopback only. The browser talks to the backend directly, so
# nothing may rewrite the client IP.
# Production: set this to the Caddy container's network, e.g.
#   TRUSTED_PROXY_IPS=172.19.0.0/16
# Without it, every visitor is recorded as Caddy's address — which collapses
# unique-visitor analytics AND turns per-IP login rate limiting into a single
# global allowance. See docs/security.md §9 and backend/app/middleware/proxy.py.
#
# Never "*" on a public deployment: that lets any client spoof its own IP.
TRUSTED_PROXY_IPS=127.0.0.1

# Contact form relay (app/services/contact_service.py). Submissions are mailed
# to CONTACT_TO_EMAIL and never stored, so the database holds no visitor PII.
#
# CONTACT_TO_EMAIL is a PRIVATE address: keep it here, in .env, only. It is
# never sent to the browser and must never be hardcoded in frontend code —
# anything in the bundle is public and gets harvested by scrapers.
#
# Leave CONTACT_TO_EMAIL empty to disable the form; it then returns 503 and the
# UI tells the visitor to email directly, rather than silently discarding it.
CONTACT_TO_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_TLS=true
SMTP_USERNAME=
# Gmail: an App Password (https://myaccount.google.com/apppasswords, requires
# 2FA), never the account password. A secret like any other — .env only.
SMTP_PASSWORD=
# Optional; defaults to SMTP_USERNAME. Must stay the authenticated mailbox —
# sending as the visitor would fail SPF/DKIM.
SMTP_FROM=

# Frontend (Vite exposes only VITE_ prefixed vars to the browser)
# Dev: the backend is a separate origin. Production: leave EMPTY so the SPA
# calls its own origin (/api/v1/...) through Caddy — an absolute cross-origin
# URL would be blocked by the CSP's `connect-src 'self'`. Baked in at image
# build time (see frontend/Dockerfile), not at container start.
VITE_API_URL=http://localhost:8000

# --- Production only (docker-compose.yml) --------------------------------
# Unused by the dev stack; all of these are required on the server.

# Public hostname served by Caddy's public site block. The Cloudflare Tunnel
# ingress rule must point at http://caddy:80 for this host.
DOMAIN=portfolio.example.com

# Cloudflare Zero Trust → Networks → Tunnels. A secret: never committed.
CLOUDFLARE_TUNNEL_TOKEN=

# The host's Tailscale address (100.x.y.z, `tailscale ip -4`). The admin site
# is published ONLY on this IP, so it is unreachable from the LAN and the
# public internet. If this is wrong or empty, Docker will either fail to bind
# or — worse — bind the admin dashboard somewhere it should not be.
TAILSCALE_IP=100.x.y.z

# Password for the least-privilege `noc_writer` database role, which may only
# INSERT/DELETE network health samples (docs/security.md §7). Generate a fresh
# random value; it is unrelated to POSTGRES_PASSWORD and must not reuse it.
# After setting it, run `make noc-role-prod` to create/rotate the role.
NOC_DB_PASSWORD=
