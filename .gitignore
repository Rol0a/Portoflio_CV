backend/uploads/

# Logs
*.log

# Private/local-only notes — real network topology, deployment parameters,
# and other environment-specific context that must never be pushed. See
# docs/security.md for the public/committed architecture equivalent (which
# uses placeholders only).
docs/CLAUDE.md

# Personal/project photos served from public/ at runtime. Kept out of git —
# privacy for the personal photo, and both are regenerable from the
# original uploads rather than something that belongs in repo history.
frontend/public/images/
