# Environment
.env
.env.*.local

# Tunnel credentials and private keys. Required by docs/CLAUDE.md §4's
# standing rule, added alongside the cloudflared compose service.
.cloudflared/
*.pem
*.key

# Tailscale-issued TLS cert for the admin site (:8443). *.key above already
# covers the private key; the directory is excluded wholesale for clarity —
# see docs/security.md §5 and SELF_HOSTING.md §6.
infrastructure/caddy/certs/

# Stray SSH keypair found untracked in repo root (2026-08-19) — filename has
# no extension so *.key above doesn't catch it. Not the key ~/.ssh/config
# actually uses for origin (different fingerprint); provenance unconfirmed.
# Ignored here as an immediate safety net — see docs/SESSION_STATE.md.
/gitkey
/gitkey.pub

# Node / frontend
node_modules/
frontend/dist/
frontend/coverage/
*.local

# Python / backend
__pycache__/
*.pyc
.venv/
venv/
backend/.pytest_cache/
backend/htmlcov/
backend/.coverage

# Docker
*.pid

# Editors / OS
.vscode/
.idea/
.DS_Store

# Uploads (dev)
backend/uploads/

# Logs
*.log

# Private/local-only notes — real network topology, deployment parameters,
# and other environment-specific context that must never be pushed. See
# docs/security.md for the public/committed architecture equivalent (which
# uses placeholders only).
docs/CLAUDE.md

# Live-state scratch doc for coordinating between concurrent/successive
# Claude Code sessions working in this repo. Point-in-time operational
# notes, not project documentation — never pushed.
docs/SESSION_STATE.md

# Personal/project photos served from public/ at runtime. Kept out of git —
# privacy for the personal photo, and both are regenerable from the
# original uploads rather than something that belongs in repo history.
frontend/public/images/
